#!/usr/bin/env bash
set -eo pipefail

echo "---> Kubectl Buildpack"

# CNB directories
LAYERS_DIR="${CNB_LAYERS_DIR:?CNB_LAYERS_DIR must be set}"

# Install kubectl into a CNB layer so it is available at launch (not in /workspace).
KUBECTL_LAYER_DIR="${LAYERS_DIR}/kubectl"
mkdir -p "$KUBECTL_LAYER_DIR"
KUBECTL_LAYER_TOML="${LAYERS_DIR}/kubectl.toml"

# Detect target architecture
# CNB_TARGET_ARCH is set by Cloud Native Buildpacks, fallback to uname -m
if [[ -n "${CNB_TARGET_ARCH:-}" ]]; then
  target_arch="$CNB_TARGET_ARCH"
elif [[ -n "${TARGETARCH:-}" ]]; then
  target_arch="$TARGETARCH"
else
  # Detect from system
  uname_arch=$(uname -m)
  case "$uname_arch" in
    x86_64)
      target_arch="amd64"
      ;;
    aarch64|arm64)
      target_arch="arm64"
      ;;
    *)
      echo " !     kubectl: Unsupported architecture: $uname_arch"
      exit 1
      ;;
  esac
fi

echo "       kubectl: Detected target architecture: $target_arch"

BP_DIR=$(cd $(dirname ${0:-}); cd ..; pwd)

TARGET_DIR="$KUBECTL_LAYER_DIR"
BIN_DIR="$TARGET_DIR/bin"
mkdir -p "$BIN_DIR"

# Download kubectl for the detected architecture
KUBECTL_VERSION=$(curl -L -s https://dl.k8s.io/release/stable.txt)
KUBECTL_URL="https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${target_arch}/kubectl"

echo "       kubectl: Downloading kubectl ${KUBECTL_VERSION} for ${target_arch}"
cd "$BIN_DIR" && curl -LO "$KUBECTL_URL" || {
  echo " !     kubectl: Failed to download kubectl for ${target_arch}"
  exit 1
}

chmod +x "$BIN_DIR/kubectl"

# Verify kubectl works (--short flag was removed in newer kubectl versions)
KUBECTL_BIN="$BIN_DIR/kubectl"
if [ -f "$KUBECTL_BIN" ]; then
  "$KUBECTL_BIN" version --client || {
    echo " !     kubectl: Binary verification failed"
    exit 1
  }
  echo "       kubectl: Successfully installed kubectl ${KUBECTL_VERSION} for ${target_arch}"
else
  echo " !     kubectl: Binary not found after installation"
  exit 1
fi

# Expose kubectl on PATH at launch time.
# Prefer CNB env contract; keep profile.d as a fallback for older launchers.
mkdir -p "$KUBECTL_LAYER_DIR/env.launch"
echo "$KUBECTL_LAYER_DIR/bin" > "$KUBECTL_LAYER_DIR/env.launch/PATH.prepend"

mkdir -p "$KUBECTL_LAYER_DIR/profile.d"
cp "$BP_DIR/profile/kubectl.sh" "$KUBECTL_LAYER_DIR/profile.d/kubectl.sh"

# Mark the layer types so it is included at launch and cached across builds.
# NOTE: CNB lifecycle expects this file at $CNB_LAYERS_DIR/<layer>.toml.
cat <<EOF >"$KUBECTL_LAYER_TOML"
[types]
build = true
launch = true
cache = true

[metadata]
architecture = "${target_arch}"
version = "${KUBECTL_VERSION}"
source = "${KUBECTL_URL}"
EOF
